# Server Port
PORT=5050

# JWT Secret Key
JWT_SECRET=your_jwt_secret_key_change_in_production

# CORS allowed origin(s) - set to your Vercel deployment URL
# e.g. https://study-sync-tau-nine.vercel.app or comma-separated list
CORS_ORIGIN=https://study-sync-tau-nine.vercel.app

# Frontend URL (for password reset links)
FRONTEND_URL=https://study-sync-tau-nine.vercel.app

# PostgreSQL Database Connection String for Prisma ORM
# --------------------------------------------------------------------------
# On Render (Production):
# Use the "Internal Database URL" from your Render PostgreSQL database dashboard:
# e.g. postgresql://studysync_user:password@dpg-xxxxxxxxxxxx-a/StudySync
#
# For Local Development:
# Use the "External Database URL" from your Render PostgreSQL database dashboard:
# e.g. postgresql://studysync_user:password@dpg-xxxxxxxxxxxx-a.oregon-postgres.render.com/StudySync?sslmode=require
# Or a local PostgreSQL instance:
# e.g. postgresql://postgres:password@localhost:5432/StudySync
# --------------------------------------------------------------------------
DATABASE_URL=postgresql://username:password@hostname:5432/StudySync?sslmode=require

# Optional: Cloudinary configuration for resource attachments
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Optional: SMTP email configuration for password recovery emails
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_email_app_password
# EMAIL_FROM=StudySync <no-reply@studysync.io>
