# In production on Render: use the Internal Database URL from your Render PostgreSQL instance
#   e.g. postgresql://studysync_user:password@dpg-xxxx:5432/studysync
DATABASE_URL=postgresql://postgres:Sushmitha2007d@hostname:5432/database_name?sslmode=require

